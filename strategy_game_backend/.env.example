# Backend environment variables (example)
# NOTE: Do not commit real secrets. Orchestrator/deploy will set these in .env.

# PostgreSQL connection URL (provided by strategy_game_database container)
POSTGRES_URL=postgresql://appuser:dbuser123@localhost:5000/myapp

# JWT signing secret (set to a strong random value in real deployments)
JWT_SECRET=change_me_to_a_long_random_secret

# Optional JWT validation settings
JWT_ISSUER=strategy-game-backend
JWT_AUDIENCE=strategy-game-frontend
JWT_EXP_MINUTES=1440

# CORS allowed origins (comma-separated); should include React frontend origin(s)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Turn timer duration in seconds
TURN_TIME_LIMIT_SECONDS=30
